<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
		<PackageVersion Include="ZString" Version="2.6.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
		<PackageVersion Include="IndexRange" Version="1.1.1" />
		<PackageVersion Include="Nullable" Version="1.3.1" />
  </ItemGroup>
</Project>
